<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TheOldGrimoire.Views.DetailPage"
             xmlns:viewmodel="clr-namespace:TheOldGrimoire.ViewModels"
             xmlns:models="clr-namespace:TheOldGrimoire.Models"
             x:DataType="viewmodel:DetailViewModel"
             BackgroundColor="{DynamicResource Background}"
             Title="">

    <ScrollView BackgroundColor="{DynamicResource Background}">
        <StackLayout Padding="20"
                     Spacing="15">

            <!-- Título -->
            <Label Text="{Binding Historia.Titulo}"
                   FontSize="24"
                   TextColor="{DynamicResource OnBackground}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- Autor y género -->
            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="Center"
                         Spacing="10">
                <Label Text="{Binding Historia.Autor}"
                       TextColor="{DynamicResource OnSurface}"
                       FontSize="16"/>
                <Label Text="•"
                       TextColor="{DynamicResource Muted}"
                       FontSize="16"/>
                <Label Text="{Binding Historia.Genero}"
                       TextColor="{DynamicResource Primary}"
                       FontSize="16"/>
            </StackLayout>

            <!-- Línea decorativa -->
            <BoxView HeightRequest="2"
                     Color="{DynamicResource Primary}"
                     HorizontalOptions="Center"
                     WidthRequest="100"/>

            <!-- Sinopsis -->
            <Label Text="📝 Sinopsis"
                   TextColor="{DynamicResource Primary}"
                   FontSize="16"
                   FontAttributes="Bold"/>
            <Label Text="{Binding Historia.Sinopsis}"
                   TextColor="{DynamicResource DetailMuted}"
                   FontSize="14"
                   LineBreakMode="WordWrap"/>

            <!-- Contenido -->
            <Label Text="📖 Historia"
                   TextColor="{DynamicResource Primary}"
                   FontSize="16"
                   FontAttributes="Bold"/>
            <Label Text="{Binding Historia.Contenido}"
                   TextColor="{DynamicResource DetailBody}"
                   FontSize="{Binding TamanioLetra}"
                   LineBreakMode="WordWrap"/>
        </StackLayout>
    </ScrollView>
</ContentPage>