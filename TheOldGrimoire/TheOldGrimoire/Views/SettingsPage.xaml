<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TheOldGrimoire.ViewModels"
             x:Class="TheOldGrimoire.Views.SettingsPage"
             x:DataType="viewmodel:SettingsViewModel"
             BackgroundColor="{DynamicResource Background}"
             Title="⚙️ Configuración">

    <ScrollView BackgroundColor="{DynamicResource Background}">
        <StackLayout Padding="20" Spacing="15">

            <!-- Título -->
            <Label Text="⚙️ Configuración"
                   TextColor="{DynamicResource Primary}"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,10,0,5"/>

            <Label Text="Personalizá tu experiencia de lectura"
                   TextColor="{DynamicResource OnSurface}"
                   FontSize="14"
                   HorizontalOptions="Center"
                   Margin="0,0,0,15"/>

            <!-- Línea decorativa -->
            <BoxView HeightRequest="2"
                     BackgroundColor="{DynamicResource Primary}"
                     HorizontalOptions="Center"
                     WidthRequest="100"
                     Margin="0,0,0,15"/>

            <!-- ================================ -->
            <!-- SECCIÓN: APARIENCIA             -->
            <!-- ================================ -->
            <Label Text="🎨 Apariencia"
                   TextColor="{DynamicResource Primary}"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,5"/>

            <!-- Tema Oscuro/Claro -->
            <Border BackgroundColor="{DynamicResource Surface}"
                   StrokeShape="RoundRectangle 15"
                   Padding="15"
                   Margin="0,0,0,10">
                <StackLayout>
                    <Label Text="🌓 Tema oscuro"
                           TextColor="{DynamicResource OnBackground}"
                           FontSize="16"/>

                    <Switch x:Name="TemaSwitch"
                            IsToggled="{Binding TemaOscuro}"
                            ThumbColor="{DynamicResource Primary}"
                            OnColor="{DynamicResource TagBackground}"/>
                </StackLayout>
            </Border>

            <!-- Color de acento -->
            <Border BackgroundColor="{DynamicResource Surface}"
                   StrokeShape="RoundRectangle 15"
                   Padding="15"
                   Margin="0,0,0,10">
                <StackLayout>
                    <Label Text="🎯 Color de acento"
                           TextColor="{DynamicResource OnBackground}"
                           FontSize="16"/>

                    <Picker x:Name="AcentoPicker"
                            Title="Seleccioná un color"
                            TextColor="{DynamicResource OnBackground}"
                            BackgroundColor="{DynamicResource Background}"
                            ItemsSource="{Binding OpcionesAcento}"
                            SelectedItem="{Binding ColorAcentoSeleccionado}"/>

                    <!-- Preview del color -->
                    <BoxView HeightRequest="20"
                             CornerRadius="5"
                             Margin="0,5,0,0"
                             Color="{Binding ColorAcentoSeleccionado, Converter={StaticResource HexColorConverter}}"/>
                </StackLayout>
            </Border>

            <!-- ================================ -->
            <!-- SECCIÓN: LECTURA               -->
            <!-- ================================ -->
            <Label Text="📖 Lectura"
                   TextColor="{DynamicResource Primary}"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,5"/>

            <!-- Tamaño de fuente -->
            <Border BackgroundColor="{DynamicResource Surface}"
                   StrokeShape="RoundRectangle 15"
                   Padding="15"
                   Margin="0,0,0,10">
                <StackLayout>
                    <Label Text="🔤 Tamaño de fuente"
                           TextColor="{DynamicResource OnBackground}"
                           FontSize="16"/>

                    <Picker x:Name="TamanoPicker"
                            Title="Seleccioná tamaño"
                            TextColor="{DynamicResource OnBackground}"
                            BackgroundColor="{DynamicResource Background}"
                            ItemsSource="{Binding OpcionesTamanoFuente}"
                            SelectedIndex="{Binding TamanoFuenteSeleccionado}"/>
                </StackLayout>
            </Border>

            <!-- Tipo de fuente -->
            <Border BackgroundColor="{DynamicResource Surface}"
                   StrokeShape="RoundRectangle 15"
                   Padding="15"
                   Margin="0,0,0,10">
                <StackLayout>
                    <Label Text="✍️ Tipo de fuente"
                           TextColor="{DynamicResource OnBackground}"
                           FontSize="16"/>

                    <Picker x:Name="FuentePicker"
                            Title="Seleccioná fuente"
                            TextColor="{DynamicResource OnBackground}"
                            BackgroundColor="{DynamicResource Background}"
                            ItemsSource="{Binding OpcionesFuente}"
                            SelectedItem="{Binding TipoFuenteSeleccionado}"/>

                    <!-- Preview de la fuente -->
                    <Label Text="Ejemplo de texto"
                           FontSize="14"
                           Margin="0,5,0,0">
                        <Label.FontFamily>
                            <Binding Path="TipoFuenteSeleccionado"/>
                        </Label.FontFamily>
                    </Label>
                </StackLayout>
            </Border>

            <!-- ================================ -->
            <!-- BOTÓN GUARDAR                   -->
            <!-- ================================ -->
            <Button Text="💾 Guardar configuración"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="{DynamicResource OnPrimaryButton}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Padding="20,15"
                    Command="{Binding GuardarConfiguracionCommand}"/>

            <!-- Mensaje de confirmación -->
            <Border x:Name="MensajeFrame"
                   BackgroundColor="{DynamicResource Surface}"
                   StrokeShape="RoundRectangle 10"
                   Padding="15"
                   IsVisible="{Binding MensajeVisible}">
                <Label Text="{Binding Mensaje}"
                       TextColor="{Binding MensajeEsExito, Converter={StaticResource MensajeColorConverter}}"
                       FontSize="14"
                       HorizontalOptions="Center"/>
            </Border>

            <!-- ================================ -->
            <!-- SECCIÓN: CUENTA                -->
            <!-- ================================ -->
            <Label Text="👤 Cuenta"
                   TextColor="{DynamicResource Primary}"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,20,0,5"/>

            <Button Text="🚪 Cerrar sesión"
                    BackgroundColor="{DynamicResource Destructive}"
                    TextColor="{DynamicResource OnBackground}"
                    CornerRadius="10"
                    Padding="20,15"
                    Command="{Binding CerrarSesionCommand}"/>

            <!-- ================================ -->
            <!-- SECCIÓN: ACERCA DE             -->
            <!-- ================================ -->
            <Label Text="ℹ️ Acerca de"
                   TextColor="{DynamicResource Primary}"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,20,0,5"/>

            <Button Text="📖 The Old Grimoire"
                    BackgroundColor="{DynamicResource Surface}"
                    TextColor="{DynamicResource OnBackground}"
                    CornerRadius="10"
                    Padding="20,15"
                    Command="{Binding VerAcercaDeCommand}"/>

            <Label Text="Versión 1.0.0"
                   TextColor="{DynamicResource Muted}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   Margin="0,5,0,20"/>

            <BoxView HeightRequest="30"/>

        </StackLayout>
    </ScrollView>
</ContentPage>