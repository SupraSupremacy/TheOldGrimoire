<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TheOldGrimoire.ViewModels"
             xmlns:models="clr-namespace:TheOldGrimoire.Models"
             x:Class="TheOldGrimoire.Views.SugerenciaDetailPage"
             x:DataType="viewmodel:SugerenciaDetailViewModel"
             BackgroundColor="#1a1a1a"
             Title="Sugerencia">

    <ScrollView BackgroundColor="#1a1a1a">
        <StackLayout Padding="20" Spacing="15">

            <!-- Título -->
            <Label Text="{Binding Sugerencia.Titulo}"
                   TextColor="#f0e6d3"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- Usuario y tiempo -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="👤" FontSize="14"/>
                <Label Text="{Binding Sugerencia.NombreUsuario}"
                       TextColor="#d4af37"
                       FontSize="14"
                       FontAttributes="Bold"/>
                <Label Text="•" TextColor="#8a7a7a" FontSize="14"/>
                <Label Text="{Binding Sugerencia.TiempoRelativo}"
                       TextColor="#8a7a7a"
                       FontSize="12"/>
            </HorizontalStackLayout>

            <!-- Línea decorativa -->
            <BoxView HeightRequest="2"
                     BackgroundColor="#d4af37"
                     HorizontalOptions="Center"
                     WidthRequest="100"/>

            <!-- Autor y género -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Label Text="{Binding Sugerencia.Autor}"
                       TextColor="#b8a8a8"
                       FontSize="14"/>
                <Label Text="{Binding Sugerencia.Genero}"
                       TextColor="#d4af37"
                       FontSize="12"
                       BackgroundColor="#3d2f1f"
                       Padding="6,2"/>
            </HorizontalStackLayout>

            <!-- Descripción -->
            <Label Text="{Binding Sugerencia.Descripcion}"
                   TextColor="#c8b8b8"
                   FontSize="15"
                   LineBreakMode="WordWrap"/>

            <!-- Votos -->
            <Border BackgroundColor="#2d2d2d"
                   StrokeShape="RoundRectangle 15"
                   Padding="15">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                    <Button Text="▲"
                            FontSize="20"
                            BackgroundColor="Transparent"
                            TextColor="#d4af37"
                            Command="{Binding VotarArribaCommand}"/>

                    <Label Text="{Binding Sugerencia.VotosNetos}"
                           TextColor="#d4af37"
                           FontSize="22"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>

                    <Button Text="▼"
                            FontSize="20"
                            BackgroundColor="Transparent"
                            TextColor="#8a7a7a"
                            Command="{Binding VotarAbajoCommand}"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Sección de comentarios -->
            <Label Text="💬 Comentarios"
                   TextColor="#d4af37"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,5"/>

            <!-- Lista de comentarios -->
            <CollectionView ItemsSource="{Binding Sugerencia.Comentarios}"
                            BackgroundColor="Transparent"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Comentario">
                        <Border BackgroundColor="#2d2d2d"
                               StrokeShape="RoundRectangle 10"
                               Padding="12"
                               Margin="0,5">
                            <StackLayout Spacing="5">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="👤" FontSize="12"/>
                                    <Label Text="{Binding NombreUsuario}"
                                           TextColor="#d4af37"
                                           FontSize="13"
                                           FontAttributes="Bold"/>
                                    <Label Text="•" TextColor="#8a7a7a" FontSize="12"/>
                                    <Label Text="{Binding TiempoRelativo}"
                                           TextColor="#8a7a7a"
                                           FontSize="11"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Texto}"
                                       TextColor="#e8dcc8"
                                       FontSize="14"/>
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Campo para nuevo comentario -->
            <Border BackgroundColor="#2d2d2d"
                   StrokeShape="RoundRectangle 15"
                   Padding="10"
                   Margin="0,10,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="NuevoComentarioEntry"
                           Placeholder="Escribí un comentario..."
                           PlaceholderColor="#8a7a7a"
                           TextColor="#f0e6d3"
                           BackgroundColor="Transparent"
                           Text="{Binding NuevoComentario}"/>

                    <Button Grid.Column="1"
                            Text="📤"
                            FontSize="20"
                            BackgroundColor="#d4af37"
                            TextColor="#1a1a1a"
                            CornerRadius="20"
                            WidthRequest="45"
                            HeightRequest="45"
                            Command="{Binding EnviarComentarioCommand}"/>
                </Grid>
            </Border>

            <BoxView HeightRequest="30"/>
        </StackLayout>
    </ScrollView>
</ContentPage>